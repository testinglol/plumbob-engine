{
  "schemaVersion": 1,
  "id": "local.seasons",
  "name": "Seasons",
  "version": "1.15.0",
  "baseGameVersion": "1.90",
  "dependencies": [],
  "overrides": [],
  "plugin": {
    "assembly": "plugin/LocalSeasons.dll",
    "entryType": "Local.Seasons.SeasonsPlugin",
    "clientEntryType": "Local.Seasons.SeasonsClientPlugin",
    "apiVersion": 6,
    "stateVersion": 2
  },
  "panels": [
    "panels/forecast.json",
    "panels/season-settings.json"
  ],
  "optionsPages": [
    {
      "category": "play",
      "panelId": "season-settings",
      "title": "Seasons",
      "items": [
        {
          "key": "daysPerSeason",
          "label": "Season Length",
          "kind": "stepper",
          "defaultValue": "7",
          "hostEnabledWhen": "homeLot",
          "choices": [
            { "value": "3", "label": "3 Days", "action": "short" },
            { "value": "7", "label": "7 Days", "action": "normal" },
            { "value": "14", "label": "14 Days", "action": "long" }
          ],
          "popupTitle": "About Season Length",
          "popupBody": "Sets how many Sim days Spring, Summer, Autumn, and Winter each last across this neighborhood while keeping your progress in the current season.",
          "popupAsset": "UIGraphics/CPanel/HDBuild/popupGrass.bmp"
        },
        {
          "key": "climate",
          "label": "Climate",
          "kind": "stepper",
          "defaultValue": "temperate",
          "hostEnabledWhen": "homeLot",
          "choices": [
            { "value": "mild", "label": "Mild", "action": "climate-mild" },
            { "value": "temperate", "label": "Temperate", "action": "climate-temperate" },
            { "value": "harsh", "label": "Harsh", "action": "climate-harsh" }
          ],
          "popupTitle": "About Regional Climate",
          "popupBody": "Adjusts seasonal temperatures and winter intensity across this neighborhood, from Mild light frost to Temperate four-season weather or Harsh deep snow.",
          "popupAsset": "UIGraphics/CPanel/HDBuild/PopupWaterTool.bmp"
        }
      ]
    }
  ],
  "cheats": [
    {
      "usage": "weather <clear|cloud|rain|thunder|snow|auto>",
      "description": "Overrides current weather"
    },
    {
      "usage": "season <spring|summer|fall|winter> [day]",
      "description": "Switches the current season"
    }
  ],
  "saveMigration": {
    "from": [
      "1.0.0",
      "1.1.0",
      "1.2.0",
      "1.3.0",
      "1.4.0",
      "1.5.0",
      "1.6.0",
      "1.7.0",
      "1.8.0",
      "1.9.0",
      "1.10.0",
      "1.11.0",
      "1.12.0",
      "1.13.0",
      "1.13.1",
      "1.13.2",
      "1.13.3",
      "1.14.0",
      "1.14.1",
      "1.14.2",
      "1.14.3"
    ]
  }
}
