static inline __attribute__((always_inline))
float print(thread const float2& lot, thread const float4& p)
{
    float foot = abs(p.w);
    bool paw = foot > 1.5;
    float size = paw ? 1.0 : foot;
    float2 along = float2(cos(p.z), sin(p.z));
    float2 across = float2(-along.y, along.x);
    float _63;
    if (paw)
    {
        _63 = 0.04500000178813934326171875;
    }
    else
    {
        _63 = 0.064999997615814208984375 * size;
    }
    float2 d = (lot - p.xy) + ((across * sign(p.w)) * _63);
    if (dot(d, d) > 0.0900000035762786865234375)
    {
        return 0.0;
    }
    float2 local = float2(dot(d, along), dot(d, across)) / float2(size);
    float edge;
    if (paw)
    {
        edge = (length(local / float2(0.0500000007450580596923828125, 0.039999999105930328369140625)) - 1.0) * 0.039999999105930328369140625;
    }
    else
    {
        float sole = (length((local - float2(0.02999999932944774627685546875, 0.0)) / float2(0.085000000894069671630859375, 0.0529999993741512298583984375)) - 1.0) * 0.0529999993741512298583984375;
        float heel = (length((local - float2(-0.039999999105930328369140625, 0.0)) / float2(0.04500000178813934326171875, 0.0460000000894069671630859375)) - 1.0) * 0.0460000000894069671630859375;
        edge = fast::min(sole, heel) * size;
    }
    return fast::clamp(0.5 - ((edge * 32.0) / 1.5), 0.0, 1.0);
}

