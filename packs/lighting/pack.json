        { "key": "enabled", "label": "Enhanced Lighting", "action": "toggle-enabled" },
        { "key": "shadows", "label": "Dynamic Shadows", "action": "toggle-shadows", "enabledWhen": "enabled" },
        { "key": "ao", "label": "Ambient Occlusion", "action": "toggle-ao", "enabledWhen": "enabled" },
        { "key": "cycle", "label": "Day / Night Cycle", "action": "toggle-cycle", "enabledWhen": "enabled" }
      ]
    }
  ]
