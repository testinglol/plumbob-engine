static inline __attribute__((always_inline))
float3 lotPoint(thread const float2& scene, thread const float& key, thread const bool& terrain, thread const float2& frame)
{
    float2 local = scene - frame;
    float _26;
    if (terrain)
    {
        _26 = ((16.0 * key) - local.y) / 40.0;
    }
    else
    {
        _26 = ((16.0 * key) - local.y) / 52.799999237060546875;
    }
    float h = _26;
    float _50;
    if (terrain)
    {
        _50 = key;
    }
    else
    {
        _50 = key - (0.800000011920928955078125 * h);
    }
    float s = _50;
    float u = local.x / 32.0;
    return float3(0.5 * (s + u), 0.5 * (s - u), h);
}

